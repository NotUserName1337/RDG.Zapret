<UserControl x:Class="RDG.Zapret.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RDG.Zapret.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="780">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <!-- ===== HERO ===== -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource AccentPill}" Padding="8,3">
                                <TextBlock Text="СПИСКИ" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding EngineHint}" Style="{StaticResource MutedText}"
                                       FontSize="10.5" Margin="9,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="600" />
                        </StackPanel>
                        <TextBlock Text="Свои домены и IP" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="23" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="Добавляйте сайты и адреса, которые должны идти через обход или напрямую. Списки применяются после перезапуска обхода."
                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"
                                   TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Style="{StaticResource GhostButton}" Height="36" Content="Обновить"
                                Command="{Binding RefreshCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Height="36" Margin="6,0,0,0"
                                Content="Открыть папку" Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== RESTART NOTICE ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Background="{DynamicResource AccentGradientSoft}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Списки изменены" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Чтобы изменения применились, перезапустите обход."
                                   Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="34"
                            Content="Перезапустить обход" Command="{Binding RestartCommand}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ===== BULK ADD ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Массовое добавление" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="Вставьте список доменов или IP: по одному в строке, через запятую или пробел."
                                       Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Height="30" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Content="Из файла" Command="{Binding BulkImportCommand}" />
                    </Grid>

                    <ListBox Style="{StaticResource ChipsList}" ItemsSource="{Binding BulkKinds}"
                             SelectedItem="{Binding SelectedBulkKind, Mode=TwoWay}"
                             DisplayMemberPath="Label" Margin="0,10,0,0" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource InputShell}" MinHeight="90" VerticalAlignment="Stretch">
                            <TextBox Style="{StaticResource InputBare}" FontSize="11"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding BulkText, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="38"
                                Margin="8,0,0,0" VerticalAlignment="Top"
                                Content="Добавить всё" Command="{Binding BulkAddCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== SECTIONS ===== -->
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ListSectionViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}"
                                           FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="36">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource InputShell}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ListInput}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox x:Name="ListInput" Style="{StaticResource InputBare}" FontSize="11.5"
                                                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Placeholder}" />
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="36"
                                            Margin="6,0,0,0" Content="Добавить" Command="{Binding AddCommand}" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />

                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardSunken}" Padding="9,6" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10.5" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                            Width="24" Height="24" Content="&#xE711;" FontSize="9"
                                                            ToolTip="Удалить"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Пока пусто" Style="{StaticResource MutedText}" FontSize="10.5"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Совет: домены надёжнее добавлять без https:// и без пути — например, example.com. Для IP можно указать один адрес или подсеть, например 10.0.0.0/8." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
