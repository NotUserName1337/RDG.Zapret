<UserControl x:Class="RDG.Zapret.Views.StrategiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RDG.Zapret.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720">

    <UserControl.Resources>
        <Style x:Key="StrategyListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" MinWidth="480" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ===== LIST ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,16,14,0">
                    <StackPanel>
                        <TextBlock Text="Стратегии zapret" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="{Binding InstallationHint}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding ListSummary}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Height="26" Padding="8,0" FontSize="10.5"
                                Margin="0,0,4,0"
                                Content="{Binding DataContext.CheckStrategyPackButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Проверить на сервере и скачать новые стратегии"
                                Command="{Binding DataContext.CheckStrategyPackCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Обновить список"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="18,14,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ListBox Style="{StaticResource ChipsList}" ItemsSource="{Binding Filters}"
                             SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" VerticalAlignment="Top">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="1" Width="220" Margin="10,0,0,0" VerticalAlignment="Top" Height="34">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InputShell}">
                                <Setter Property="Height" Value="34" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=StrategySearch}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBox x:Name="StrategySearch" Style="{StaticResource InputBare}" Padding="32,0,10,0" FontSize="12.5"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="Поиск…" Style="{StaticResource MutedText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>
                </Grid>

                <ListBox x:Name="StrategyList" Grid.Row="2" Margin="8,0,8,8" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource StrategyListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StrategyItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SurfaceHover}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="13.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                        <Border Style="{StaticResource Pill}" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}" FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <Border Style="{StaticResource AccentPill}" Padding="7,2" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="ЛУЧШАЯ" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Border Background="#2634D399" BorderBrush="#5534D399" BorderThickness="1"
                                                CornerRadius="20" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="АКТИВНА" FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}"
                                               FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            MinWidth="46">
                                    <TextBlock Text="{Binding ScoreText}" FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{Binding Score, Converter={StaticResource ScoreBrush}}" />
                                    <TextBlock Text="балл" Style="{StaticResource MutedText}" FontSize="9.5"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== DETAIL ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,20,20">

                    <Border Style="{StaticResource CardSunken}" Padding="14" Margin="0,0,0,14"
                            Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource AccentGradientSoft}"
                            BorderBrush="{DynamicResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding TestingName}" FontWeight="SemiBold" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" />
                            <ProgressBar Value="{Binding TestingProgress, Mode=OneWay}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding TestingStatus}" Style="{StaticResource MutedText}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ВЫБРАННАЯ СТРАТЕГИЯ" Style="{StaticResource SectionLabel}" />

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedItem.Name}" Style="{StaticResource SectionHeading}"
                                   FontSize="19" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Style="{StaticResource Pill}" Padding="8,3">
                                <TextBlock Text="{Binding SelectedItem.Tag}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Padding="8,3" Margin="6,0,0,0">
                                <TextBlock Text="{Binding SelectedItem.EngineName}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <Border Background="#2634D399" BorderBrush="#5534D399" BorderThickness="1"
                                    CornerRadius="20" Padding="8,3" Margin="6,0,0,0"
                                    Visibility="{Binding SelectedItem.IsActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="АКТИВНА" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ОЦЕНКА ДОСТУПНОСТИ" Style="{StaticResource SectionLabel}" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedItem.ScoreText}" FontSize="38" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedItem.Score, Converter={StaticResource ScoreBrush}}"
                                               Visibility="{Binding SelectedItem.HasScore, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="нет данных" FontSize="15" Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center" Margin="0,12,0,0"
                                               Visibility="{Binding SelectedItem.HasScore, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedItem.ScoreCaption}" Style="{StaticResource MutedText}"
                                           FontSize="10.5" HorizontalAlignment="Right" TextAlignment="Right" MaxWidth="150" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Value="{Binding SelectedItem.Score, Mode=OneWay}" Margin="0,8,0,0" Height="6"
                                     Visibility="{Binding SelectedItem.HasScore, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" Height="40" Command="{Binding StartCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Запустить" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="40"
                                    Command="{Binding TestCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Проверить" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Style="{StaticResource GhostButton}" Height="34" Margin="0,6,0,0"
                                HorizontalAlignment="Left" Command="{Binding StopCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Остановить обход" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DangerBrush}" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Файл" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,14,8" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedItem.FileName}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="Движок" Style="{StaticResource MutedText}" FontSize="11"
                                       Margin="0,0,14,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.EngineName}"
                                       FontSize="11" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="2" Text="Тест" Style="{StaticResource MutedText}" FontSize="11"
                                       Margin="0,0,14,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.ScoreCaption}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Grid>

                        <Grid Margin="0,18,0,8">
                            <TextBlock Text="АРГУМЕНТЫ ЗАПУСКА" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Width="28" Height="26" Content="&#xE8C8;"
                                        ToolTip="Скопировать аргументы" Command="{Binding CopyArgsCommand}" />
                                <Button Style="{StaticResource IconButton}" Width="28" Height="26" Content="&#xE8A7;"
                                        ToolTip="Открыть файл стратегии" Command="{Binding OpenFileCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBox Style="{StaticResource CodeBox}" Text="{Binding SelectedItem.Preset.ArgumentsPretty, Mode=OneWay}"
                                 Height="170" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="Стратегия не выбрана" Style="{StaticResource SectionHeading}" Margin="0,8,0,0" />
                        <TextBlock Text="Выберите стратегию в списке слева, чтобы увидеть её аргументы и запустить проверку."
                                   Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
