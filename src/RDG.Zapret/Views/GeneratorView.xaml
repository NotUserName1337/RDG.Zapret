<UserControl x:Class="RDG.Zapret.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RDG.Zapret.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800">

    <UserControl.Resources>
        <Style x:Key="GenModeRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{DynamicResource SurfaceSunken}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="11" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <!-- engine notice -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Генератор параметров" Style="{StaticResource CardTitle}" FontSize="13.5" />
                        <TextBlock Text="{Binding EngineNote}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="32" Content="Настройки"
                            VerticalAlignment="Center" Command="{Binding NavigateSettingsCommand}" />
                </Grid>
            </Border>

            <!-- config -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Параметры перебора" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="Генератор создаёт варианты fake/split и проверяет их на реальных сервисах."
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />

                        <TextBlock Text="РЕЖИМ" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                        <UniformGrid Columns="3">
                            <RadioButton Style="{StaticResource GenModeRadio}" GroupName="GenMode"
                                         IsChecked="{Binding IsFast, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Быстрый" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="до 30 попыток" Style="{StaticResource MutedText}" FontSize="10"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource GenModeRadio}" GroupName="GenMode"
                                         IsChecked="{Binding IsFull, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Полный" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="до 60 попыток" Style="{StaticResource MutedText}" FontSize="10"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource GenModeRadio}" GroupName="GenMode" Margin="0"
                                         IsChecked="{Binding IsMax, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Максимальный" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="до 120 попыток" Style="{StaticResource MutedText}" FontSize="10"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{Binding MaxAttemptsText}" Style="{StaticResource MonoText}"
                                       FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EstimateText}" Style="{StaticResource MutedText}"
                                       FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KeepBestRunning, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Оставить лучшую стратегию включённой" FontSize="12.5" />
                                <TextBlock Text="Если все сервисы заработают, обход продолжит работать"
                                           Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Что проверять" Style="{StaticResource SectionHeading}" />
                                <TextBlock Text="{Binding InstallationHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,2">
                                <TextBlock Text="{Binding SelectedServicesCount, StringFormat=выбрано {0}}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Services}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ServiceToggleViewModel}">
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,0,11" IsEnabled="{Binding DataContext.IsGenerating, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="6"
                                                    Background="{Binding ColorFrom, Converter={StaticResource HexToBrush}}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="8"
                                                           FontWeight="Bold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="7,0,0,0" FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Если сервис не входит в список, он не влияет на успех генерации."
                                   Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- progress -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource AccentPill}" Padding="8,3">
                                <TextBlock Text="ГЕНЕРАТОР" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource MutedText}"
                                       FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MaxAttemptsText}" Style="{StaticResource MutedText}"
                                       FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EstimateText}" Style="{StaticResource MutedText}"
                                       FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{Binding Headline}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0"
                                   TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Margin="0,14,0,0" Height="8" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="{Binding AttemptsText}" Style="{StaticResource MutedText}" FontSize="10.5" />
                            <TextBlock Text="{Binding EtaText}" Style="{StaticResource MutedText}" FontSize="10.5"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="БЕЗ ОБХОДА" Style="{StaticResource SectionLabel}" VerticalAlignment="Top"
                                       Margin="0,2,12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding BaselineText}" Style="{StaticResource MutedText}"
                                       FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding BaselineRatio}" Style="{StaticResource MonoText}"
                                       FontSize="11" Margin="10,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0" MinWidth="150">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Начать генерацию" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Height="42" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Отменить" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Пока не заработают все выбранные сервисы" Style="{StaticResource MutedText}"
                                   FontSize="9.5" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- best -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding HasBest, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ЛУЧШИЙ РЕЗУЛЬТАТ" Style="{StaticResource SectionLabel}"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding BestName}" Style="{StaticResource SectionHeading}" FontSize="17"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BestSummary}" Style="{StaticResource MonoText}" FontSize="10.5"
                                       Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding BestScoreText}" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding BestServicesText, StringFormat=сервисов {0}}"
                                           Style="{StaticResource MutedText}" FontSize="9.5" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButton}" Height="36" Content="Сохранить"
                                    Command="{Binding SaveBestCommand}"
                                    Visibility="{Binding HasSavedPreset, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource PrimaryButton}" Height="36" Content="Применить"
                                    Command="{Binding ApplyBestCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardSunken}" Padding="10" Margin="0,12,0,0"
                            Visibility="{Binding HasSavedPreset, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SavedPresetPath}" Style="{StaticResource MonoText}" FontSize="10"
                                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- attempts -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Попытки" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding SummaryText, Converter={StaticResource StringEmptyToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Rows.Count, StringFormat={}{0} вариантов}" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GeneratorRowViewModel}">
                                <Border Style="{StaticResource CardSunken}" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                <Border Background="#2634D399" BorderBrush="#5534D399" BorderThickness="1"
                                                        CornerRadius="20" Padding="6,1" Margin="7,0,0,0"
                                                        Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ЛУЧШАЯ" FontSize="8" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MonoText}"
                                                       FontSize="9.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Summary}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Dots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Width="6" Height="6" Margin="0,0,4,0"
                                                                     ToolTip="{Binding Tooltip}"
                                                                     Fill="{Binding Status, Converter={StaticResource ProbeStatusBrush}}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}"
                                                           FontSize="10" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ScoreText}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{Binding Score, Converter={StaticResource ScoreBrush}}" />
                                                <TextBlock Text="/ 100" Style="{StaticResource MutedText}" FontSize="9"
                                                           VerticalAlignment="Bottom" Margin="3,0,0,1" />
                                            </StackPanel>
                                            <ProgressBar Value="{Binding Score, Mode=OneWay}" Height="4" Margin="0,5,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ServicesText}" Style="{StaticResource MonoText}"
                                                       FontSize="10" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource MutedText}"
                                                       FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,14,0,4"
                                Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                        <TextBlock Text="Пока нет попыток" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="Нажмите «Начать генерацию» — RDG.Zapret будет перебирать параметры, пока все выбранные сервисы не заработают."
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
