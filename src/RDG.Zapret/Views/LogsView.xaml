<UserControl x:Class="RDG.Zapret.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720">

    <UserControl.Resources>
        <Style x:Key="LogListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="{DynamicResource BorderSoft}"
                                BorderThickness="0,0,0,1" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- toolbar -->
            <Grid Margin="18,14,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox Style="{StaticResource ChipsList}" ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" VerticalAlignment="Center">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="1" Margin="6,0,10,8" MaxWidth="280" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Height="34">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource InputShell}">
                            <Setter Property="Height" Value="34" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=LogSearch}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBox x:Name="LogSearch" Style="{StaticResource InputBare}" Padding="32,0,10,0" FontSize="12.5"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Поиск по журналу…" Style="{StaticResource MutedText}" FontSize="12"
                                   VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                              Content="Автоскролл" FontSize="11" Margin="0,0,10,8" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Копировать видимые записи"
                            Command="{Binding CopyCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Очистить журнал"
                            Command="{Binding ClearCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Открыть папку журналов"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>

            <!-- list -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <ListBox x:Name="LogList" ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource LogListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoText}"
                                           FontSize="10.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Top"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" MaxWidth="900" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="9.5"
                                               Margin="10,2,0,0" VerticalAlignment="Top" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="28"
                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Журнал пуст" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="Здесь появятся события приложения и вывод winws.exe" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- footer -->
            <Border Grid.Row="2" Background="#CC0A1119" Padding="14,6"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedText}" FontSize="10" />
                    <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource MutedText}"
                               FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
