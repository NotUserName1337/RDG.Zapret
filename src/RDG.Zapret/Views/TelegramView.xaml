<UserControl x:Class="RDG.Zapret.Views.TelegramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">

            <!-- ===== STATUS ===== -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Telegram-прокси" Style="{StaticResource SectionHeading}" FontSize="18" />
                                <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="9,3">
                                    <TextBlock Text="{Binding StatusPill}" FontSize="9.5" FontWeight="Bold"
                                               Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}"
                                       Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,0">
                                <Run Text="Локальный MTProto-прокси " />
                                <Run Text="{Binding PortLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" → Telegram через WebSocket" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Height="36" MinWidth="156"
                                    Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" />
                            <Button Style="{StaticResource GhostButton}" Height="36" Margin="8,0,0,0"
                                    Content="Открыть в Telegram" Command="{Binding OpenTelegramCommand}" />
                            <Button Style="{StaticResource GhostButton}" Height="36" Margin="6,0,0,0"
                                    Content="Копировать ссылку" Command="{Binding CopyLinkCommand}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Height="4" Margin="0,14,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource SurfaceSunken}" BorderThickness="0"
                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" FontSize="10.5"
                               Margin="0,6,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- external notice -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16"
                    Visibility="{Binding IsExternal, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Прокси уже запущен отдельной программой" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="RDG.Zapret не будет останавливать чужой процесс. Кнопка «Открыть в Telegram» использует тот же secret, поэтому подключение продолжит работать. Чтобы управлять прокси из приложения, закройте TgWsProxy через его иконку в трее и нажмите «Включить прокси»." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== LINK + SETTINGS ===== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Подключение" Style="{StaticResource SectionHeading}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Text="Ссылка открывает Telegram и добавляет прокси автоматически. Если Telegram не открылся — скопируйте ссылку и отправьте её себе в «Избранное», затем нажмите на неё." />

                        <Border Style="{StaticResource CardSunken}" Padding="12,10">
                            <TextBlock Text="{Binding LinkDisplay}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostButton}" Height="30" Content="{Binding LinkToggleText}"
                                    Command="{Binding ToggleLinkCommand}" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Margin="6,0,0,0"
                                    Content="Копировать ссылку" Command="{Binding CopyLinkCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <TextBlock Text="Ручная настройка в Telegram" FontSize="11.5" FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Тип" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock Text="MTProto" FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <TextBlock Text="Сервер / порт" Style="{StaticResource MutedText}" FontSize="10" />
                                <TextBlock Text="{Binding PortLabel}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding SecretDisplay}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostButton}" Height="26" Margin="10,0,0,0"
                                    Content="{Binding SecretToggleText}" Command="{Binding ToggleSecretCommand}" />
                            <Button Style="{StaticResource GhostButton}" Height="26" Margin="6,0,0,0"
                                    Content="Копировать" Command="{Binding CopySecretCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Настройки прокси" Style="{StaticResource SectionHeading}" />

                        <TextBlock Text="Порт" Style="{StaticResource SectionLabel}" Margin="0,14,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="32" Margin="8,0,0,0"
                                    Content="Применить" Command="{Binding SavePortCommand}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"
                                   Text="По умолчанию 1443. После смены порта обновите прокси в Telegram." TextWrapping="Wrap" />

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,14" />

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoStart, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Запускать вместе с RDG.Zapret" FontSize="12" />
                                <TextBlock Text="Если TgWsProxy уже установлен" Style="{StaticResource MutedText}"
                                           FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"
                                  IsChecked="{Binding StopOnExit, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Останавливать при выходе" FontSize="12" />
                                <TextBlock Text="Внешний TgWsProxy не затрагивается" Style="{StaticResource MutedText}"
                                           FontSize="10" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <Button Style="{StaticResource DangerButton}" Height="30" HorizontalAlignment="Left"
                                Content="Новый секрет" Command="{Binding RotateSecretCommand}" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Новый secret потребует заново подключить прокси в Telegram." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== COMPONENT ===== -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Компонент TgWsProxy" Style="{StaticResource SectionHeading}" />
                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="8,2">
                                <TextBlock Text="{Binding InstalledVersionText}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="640"
                                   HorizontalAlignment="Left"
                                   Text="TgWsProxy — отдельная программа Flowseal (MIT). Она работает в своём трее, а RDG.Zapret запускает и останавливает её. Компонент можно обновить вручную с GitHub или с сервера обновлений." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Content="Скачать / обновить"
                                Command="{Binding DownloadCommand}" />
                        <Button Style="{StaticResource GhostButton}" Height="32" Margin="6,0,0,0"
                                Content="Папка" Command="{Binding OpenFolderCommand}" />
                        <Button Style="{StaticResource GhostButton}" Height="32" Margin="6,0,0,0"
                                Content="Журнал" Command="{Binding OpenLogCommand}" />
                        <Button Style="{StaticResource GhostButton}" Height="32" Margin="6,0,0,0"
                                Content="GitHub" Command="{Binding OpenGitHubCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== HOW TO ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Как включить" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="1. " />
                        <Run Text="Нажмите «Включить прокси». Если компонент ещё не установлен, он скачается автоматически." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="2. " />
                        <Run Text="Нажмите «Открыть в Telegram». Telegram предложит подключить прокси — согласитесь." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="3. " />
                        <Run Text="Если Telegram не открылся, скопируйте ссылку и отправьте её себе в «Избранное», затем нажмите на неё." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" FontSize="10.5" TextWrapping="Wrap"
                               Text="Прокси работает только локально на этом компьютере. Он не является VPN и не влияет на другие программы. Telegram можно использовать одновременно с обходом zapret." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
