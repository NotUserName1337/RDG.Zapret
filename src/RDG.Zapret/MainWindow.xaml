<Window x:Class="RDG.Zapret.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RDG.Zapret.ViewModels"
        Title="RDG.Zapret"
        Width="1320" Height="850"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgDeep}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="20,22,20,20">
                    <Grid Width="40" Height="40">
                        <Image Source="Assets/logo.png" Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RDG.Zapret" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="16.5" FontWeight="SemiBold" />
                        <TextBlock Text="DPI CONTROL" Style="{StaticResource SectionLabel}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="2" Margin="12,4,12,0"
                         Style="{StaticResource NavList}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="15" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontSize="13.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Engine -->
                <Border Grid.Row="1" Margin="14,0,14,8" Style="{StaticResource CardTight}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="ЯДРО ОБХОДА" Style="{StaticResource SectionLabel}" />
                        <UniformGrid Columns="2" Margin="0,7,0,0">
                            <RadioButton Style="{StaticResource EngineRadio}" GroupName="SidebarEngine"
                                         Content="zapret"
                                         IsChecked="{Binding IsZapretSelected, Mode=TwoWay}"
                                         ToolTip="{Binding ZapretEngineTooltip}" Margin="0,0,3,0" />
                            <RadioButton Style="{StaticResource EngineRadio}" GroupName="SidebarEngine"
                                         Content="zapret2"
                                         IsChecked="{Binding IsZapret2Selected, Mode=TwoWay}"
                                         ToolTip="{Binding Zapret2EngineTooltip}" Margin="3,0,0,0" />
                        </UniformGrid>
                        <TextBlock Text="{Binding EngineHint}" Style="{StaticResource MutedText}"
                                   FontSize="9.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="3" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding Zapret2InstallProgress, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SurfaceSunken}" BorderThickness="0"
                                     Visibility="{Binding IsZapret2Installing, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Status card -->
                <Border Grid.Row="3" Margin="14,6,14,8" Style="{StaticResource CardTight}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseStory">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.35" Duration="0:0:1.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PulseStory" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusTitle}" Margin="8,0,0,0" FontSize="12.5"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusSubtitle}" Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ВРЕМЯ РАБОТЫ" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource MonoText}"
                                           FontSize="15" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE768;" Width="32" Height="32"
                                        ToolTip="Запустить обход" Command="{Binding StartCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE71A;" Width="32" Height="32"
                                        ToolTip="Остановить обход" Command="{Binding StopCommand}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="4" Margin="20,2,20,18">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
                    <Grid>
                        <TextBlock Text="{Binding VersionText, StringFormat=v{0}}" Style="{StaticResource MutedText}" />
                        <Button Content="GitHub" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                Height="24" Padding="6,0" FontSize="11" Command="{Binding OpenGithubCommand}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid x:Name="HeaderBar" Margin="28,0,14,0" Background="Transparent"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageHeading}" FontSize="22" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Свернуть" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="Развернуть" />
                    <Button Style="{StaticResource WindowButton}" Tag="close" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!-- Page host -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="28,6,28,26"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <!-- Toast -->
            <Border Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,30,28" MaxWidth="460" CornerRadius="12" Padding="14,12"
                    Background="#141F2C" BorderThickness="1"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="50">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="BorderBrush" Value="#66FB7185" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE73E;" />
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding ToastText}" Margin="10,0,0,0" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= DOWNLOAD OVERLAY ================= -->
        <Border Grid.ColumnSpan="2" Panel.ZIndex="90" Background="#B305080D"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="500" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="8" Opacity="0.55" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentGradient}">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Загрузка стратегий" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="Последний релиз Flowseal с GitHub" Style="{StaticResource MutedText}"
                                       FontSize="10.5" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource BodyText}"
                               Margin="0,18,0,0" FontSize="12.5" />
                    <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Height="8" Margin="0,10,0,0" />
                    <Grid Margin="0,7,0,0">
                        <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:0}%}"
                                   Style="{StaticResource MonoText}" FontSize="10" />
                        <TextBlock Text="Не закрывайте приложение" Style="{StaticResource MutedText}" FontSize="10"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding DownloadTargetPath}" Style="{StaticResource MutedText}" FontSize="9.5"
                               Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DownloadTargetPath}" />

                    <Button Style="{StaticResource SecondaryButton}" Height="36" Content="Отмена"
                            Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Right" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
